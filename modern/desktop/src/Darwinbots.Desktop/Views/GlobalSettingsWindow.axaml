<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Darwinbots.Desktop.Views.GlobalSettingsWindow"
        Title="Darwinbots Global Settings" Width="1080" Height="780" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#F4F0E6">
  <Window.Styles>
    <Style Selector="TextBlock.section"><Setter Property="FontFamily" Value="Bahnschrift"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#1D2824"/><Setter Property="LetterSpacing" Value="1.5"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#FFFCF5"/><Setter Property="BorderBrush" Value="#D4CFC1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="18"/></Style>
    <Style Selector="TabItem"><Setter Property="FontFamily" Value="Bahnschrift"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="18,15"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#416E35"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#66706B"/><Setter Property="FontSize" Value="11"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="76,*,66">
    <Border Background="#FBF9F2" BorderBrush="#C8C3B6" BorderThickness="0,0,0,1" Padding="24,14">
      <StackPanel Spacing="2"><TextBlock Text="GLOBAL SETTINGS" FontFamily="Bahnschrift" FontSize="24" FontWeight="Bold" LetterSpacing="1.6"/><TextBlock Text="Configure the simulation contract, mutation pressure, and evolution rules" Classes="muted" FontSize="12"/></StackPanel>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="1" TabStripPlacement="Left" Margin="16" Background="Transparent">
      <TabItem x:Name="MainTab" Header="MAIN">
        <ScrollViewer><StackPanel Margin="20,0,8,24" Spacing="14">
          <Border Classes="card"><StackPanel Spacing="11"><TextBlock Classes="section" Text="DISPLAY + WORKFLOW"/>
            <CheckBox x:Name="FixedRatio" Content="Fixed ratio display"/><CheckBox x:Name="OldColors" Content="Use legacy organism colors"/><CheckBox x:Name="SuppressBuoyancy" Content="Suppress buoyancy controls"/><CheckBox x:Name="VideoOff" Content="Disable video capture"/><CheckBox x:Name="HideTray" Content="Hide system tray icon"/>
            <Grid ColumnDefinitions="*,150"><TextBlock Text="Graph updates per tick"/><NumericUpDown Grid.Column="1" x:Name="GraphUpdates" Minimum="1" Maximum="1000"/></Grid>
            <Grid ColumnDefinitions="*,150"><TextBlock Text="Body cutoff"/><NumericUpDown Grid.Column="1" x:Name="BodyCutoff" Minimum="0" Maximum="32000"/></Grid>
          </StackPanel></Border>
          <Border Classes="card"><StackPanel Spacing="11"><TextBlock Classes="section" Text="STARTUP + COMPATIBILITY"/>
            <CheckBox x:Name="GreedyEnforcement" Content="Enforce greedy behavior rules"/><CheckBox x:Name="NewSeed" Content="Generate a new seed when starting"/><CheckBox x:Name="SafeMode" Content="Safe-mode startup"/><CheckBox x:Name="FindBestEnergyWeighting" Content="Weight Find Best by energy"/>
            <Grid ColumnDefinitions="*,*"><TextBlock VerticalAlignment="Center" Text="Main directory"/><TextBox Grid.Column="1" x:Name="MainDirectory" PlaceholderText="Optional directory"/></Grid>
            <TextBlock Classes="muted" Text="Internet picture controls remain local-only in offline mode." TextWrapping="Wrap"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="AdvancedMutationTab" Header="ADVANCED MUTATION">
        <ScrollViewer><StackPanel Margin="20,0,8,24" Spacing="14">
          <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="MUTATION POLICIES"/>
            <CheckBox x:Name="Point2Enabled" Content="Point2 mutation"/><CheckBox x:Name="CopyError2Enabled" Content="CopyError2 mutation"/><CheckBox x:Name="AmplificationEnabled" Content="Amplification"/><CheckBox x:Name="TranslocationEnabled" Content="Translocation"/><CheckBox x:Name="Delta2Enabled" Content="Delta2 evolves inherited mutation rates"/>
            <Grid ColumnDefinitions="*,150"><TextBlock Text="Delta2 interval"/><NumericUpDown Grid.Column="1" x:Name="Delta2Interval" Minimum="1" Maximum="100000000"/></Grid>
            <Grid ColumnDefinitions="*,150"><TextBlock Text="Delta2 rate step"/><NumericUpDown Grid.Column="1" x:Name="Delta2RateStep" Minimum="-100000" Maximum="100000" Increment="0.1"/></Grid>
            <Grid ColumnDefinitions="*,150"><TextBlock Text="Distribution step"/><NumericUpDown Grid.Column="1" x:Name="Delta2DistributionStep" Minimum="-100000" Maximum="100000" Increment="0.1"/></Grid>
            <Grid ColumnDefinitions="*,150"><TextBlock Text="Preference step (%)"/><NumericUpDown Grid.Column="1" x:Name="Delta2PreferenceStep" Minimum="-100" Maximum="100"/></Grid>
          </StackPanel></Border>
          <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="NORMALIZATION + OSCILLATION"/>
            <CheckBox x:Name="NormalizationEnabled" Content="Normalize mutation rates by DNA length"/><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA length at slowest rate"/><NumericUpDown Grid.Column="1" x:Name="NormalizationDnaLength" Minimum="1" Maximum="32000"/></Grid>
            <Grid ColumnDefinitions="*,150"><TextBlock Text="Oscillation mode"/><ComboBox Grid.Column="1" x:Name="OscillationMode"/></Grid>
            <Grid ColumnDefinitions="*,150"><TextBlock Text="Oscillation period"/><NumericUpDown Grid.Column="1" x:Name="OscillationPeriod" Minimum="0" Maximum="100000000"/></Grid>
            <Grid ColumnDefinitions="*,150"><TextBlock Text="Oscillation amplitude"/><NumericUpDown Grid.Column="1" x:Name="OscillationAmplitude" Minimum="-1" Maximum="1" Increment="0.05"/></Grid>
            <CheckBox x:Name="EpigeneticReset" Content="Reset inherited epigenetic memory after overload"/><Grid ColumnDefinitions="*,150"><TextBlock Text="Epigenetic amplification"/><NumericUpDown Grid.Column="1" x:Name="EpigeneticAmplification" Minimum="0" Maximum="100" Increment="0.1"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Overload threshold"/><NumericUpDown Grid.Column="1" x:Name="EpigeneticOverloadThreshold" Minimum="1" Maximum="100000000"/></Grid><CheckBox x:Name="SaveAsTemporaryGene" Content="Save inherited memory as temporary gene"/>
          </StackPanel></Border>
          <Button x:Name="CustomSimulationCostsButton" Content="OPEN CUSTOM SIMULATION COSTS" HorizontalAlignment="Left" Click="CustomSimulationCosts_Click"/>
          <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="SIMULATION COSTS"/><TextBlock Classes="muted" Text="Rust owns these values at runtime. Zero leaves a cost disabled." TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="*,150"><TextBlock Text="Global cost multiplier"/><NumericUpDown Grid.Column="1" x:Name="GlobalCostMultiplier" Minimum="0" Maximum="100000" Increment="0.01"/></Grid>
            <Grid ColumnDefinitions="*,150"><TextBlock Text="DNA Number"/><NumericUpDown Grid.Column="1" x:Name="DnaNumber" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA Dereference"/><NumericUpDown Grid.Column="1" x:Name="DnaDereference" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA Basic"/><NumericUpDown Grid.Column="1" x:Name="DnaBasic" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA Advanced"/><NumericUpDown Grid.Column="1" x:Name="DnaAdvanced" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA Bitwise"/><NumericUpDown Grid.Column="1" x:Name="DnaBitwise" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA Condition"/><NumericUpDown Grid.Column="1" x:Name="DnaCondition" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA Logic"/><NumericUpDown Grid.Column="1" x:Name="DnaLogic" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA Store"/><NumericUpDown Grid.Column="1" x:Name="DnaStore" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA Flow"/><NumericUpDown Grid.Column="1" x:Name="DnaFlow" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid>
            <Grid ColumnDefinitions="*,150"><TextBlock Text="DNA upkeep"/><NumericUpDown Grid.Column="1" x:Name="DnaUpkeep" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA copy"/><NumericUpDown Grid.Column="1" x:Name="DnaCopy" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Movement"/><NumericUpDown Grid.Column="1" x:Name="MovementCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Rotation"/><NumericUpDown Grid.Column="1" x:Name="RotationCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Tie formation"/><NumericUpDown Grid.Column="1" x:Name="TieFormationCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Shot formation"/><NumericUpDown Grid.Column="1" x:Name="ShotFormationCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Venom"/><NumericUpDown Grid.Column="1" x:Name="VenomCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Poison"/><NumericUpDown Grid.Column="1" x:Name="PoisonCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Slime"/><NumericUpDown Grid.Column="1" x:Name="SlimeCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Shell"/><NumericUpDown Grid.Column="1" x:Name="ShellCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Body upkeep"/><NumericUpDown Grid.Column="1" x:Name="BodyUpkeep" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Chloroplast construction"/><NumericUpDown Grid.Column="1" x:Name="ChloroplastConstructionCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Virus"/><NumericUpDown Grid.Column="1" x:Name="VirusCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid>
            <Grid ColumnDefinitions="*,150"><TextBlock Text="Age base"/><NumericUpDown Grid.Column="1" x:Name="AgeBase" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Age start"/><NumericUpDown Grid.Column="1" x:Name="AgeStart" Minimum="0" Maximum="100000000" Increment="1"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Age linear"/><NumericUpDown Grid.Column="1" x:Name="AgeLinear" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Age logarithmic"/><NumericUpDown Grid.Column="1" x:Name="AgeLogarithmic" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Dynamic multiplier"/><NumericUpDown Grid.Column="1" x:Name="DynamicMultiplier" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><CheckBox x:Name="DynamicAllRobots" Content="Apply dynamic cost to all robots"/><Grid ColumnDefinitions="*,150"><TextBlock Text="Dynamic target population"/><NumericUpDown Grid.Column="1" x:Name="DynamicTargetPopulation" Minimum="0" Maximum="100000000"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Dynamic population range"/><NumericUpDown Grid.Column="1" x:Name="DynamicPopulationRange" Minimum="0" Maximum="100000000"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Dynamic sensitivity"/><NumericUpDown Grid.Column="1" x:Name="DynamicSensitivity" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><CheckBox x:Name="DynamicAllowNegative" Content="Allow negative dynamic costs"/><Grid ColumnDefinitions="*,150"><TextBlock Text="Lower zero threshold"/><NumericUpDown Grid.Column="1" x:Name="DynamicLowerZeroThreshold" Minimum="0" Maximum="100000000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Upper zero threshold"/><NumericUpDown Grid.Column="1" x:Name="DynamicUpperZeroThreshold" Minimum="0" Maximum="100000000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Lower reinstate threshold"/><NumericUpDown Grid.Column="1" x:Name="DynamicLowerReinstateThreshold" Minimum="0" Maximum="100000000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Upper reinstate threshold"/><NumericUpDown Grid.Column="1" x:Name="DynamicUpperReinstateThreshold" Minimum="0" Maximum="100000000" Increment="0.01"/></Grid>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="LeagueTab" Header="LEAGUE">
        <ScrollViewer><StackPanel Margin="20,0,8,24" Spacing="14"><Border Classes="card"><StackPanel Spacing="12"><TextBlock Classes="section" Text="LEAGUE SETTINGS"/><TextBlock Text="League content is a typed seam owned by the offline-modes task." TextWrapping="Wrap"/><TextBlock Classes="muted" Text="Online play is excluded from this runtime. The tab remains reachable so the historical workflow has a stable owner boundary." TextWrapping="Wrap"/><CheckBox x:Name="LeagueOfflineOwned" Content="Owned by offline modes" IsChecked="True" IsEnabled="False"/></StackPanel></Border></StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="EvolutionTab" Header="EVOLUTION">
        <ScrollViewer><StackPanel Margin="20,0,8,24" Spacing="14"><Border Classes="card"><StackPanel Spacing="11"><TextBlock Classes="section" Text="EVOLUTION MODE"/><Grid ColumnDefinitions="*,200"><TextBlock Text="Mode" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="EvolutionMode"/></Grid><Grid ColumnDefinitions="*,200"><TextBlock Text="Source bot"/><TextBox Grid.Column="1" x:Name="SourceBot"/></Grid><Grid ColumnDefinitions="*,200"><TextBlock Text="Stage length"/><NumericUpDown Grid.Column="1" x:Name="StageLength" Minimum="1" Maximum="1000000"/></Grid><Grid ColumnDefinitions="*,200"><TextBlock Text="Cycle length"/><NumericUpDown Grid.Column="1" x:Name="CycleLength" Minimum="1" Maximum="100000000"/></Grid></StackPanel></Border><Border Classes="card"><StackPanel Spacing="11"><TextBlock Classes="section" Text="EVOLUTION GUARDRAILS"/><CheckBox x:Name="ReducePopulationOscillation" Content="Reduce population oscillation"/><CheckBox x:Name="AutoGraphs" Content="Create graphs automatically"/><CheckBox x:Name="OptionalInternetStartup" Content="Optional internet startup (offline inert)"/><CheckBox x:Name="NormalizeDnaSize" Content="Normalize DNA size"/><Grid ColumnDefinitions="*,200"><TextBlock Text="Zerobot initial DNA length"/><NumericUpDown Grid.Column="1" x:Name="ZerobotInitialDnaLength" Minimum="1" Maximum="32000"/></Grid><CheckBox x:Name="RestrictMutation" Content="Restrict mutation"/><CheckBox x:Name="RestrictSpeciesMixing" Content="Restrict species mixing"/></StackPanel></Border></StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#E5E0D4" BorderBrush="#C8C3B6" BorderThickness="0,1,0,0" Padding="18,10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Settings are saved with the desktop profile and translated to Rust at world start." Classes="muted" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="CancelButton" Content="CANCEL" Click="Cancel_Click"/><Button x:Name="ApplyButton" Classes="primary" Content="SAVE SETTINGS" Click="Apply_Click"/></StackPanel></Grid></Border>
  </Grid>
</Window>
