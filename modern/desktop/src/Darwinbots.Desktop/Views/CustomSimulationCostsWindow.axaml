<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Darwinbots.Desktop.Views.CustomSimulationCostsWindow"
        Title="Custom Simulation Costs" Width="760" Height="820" MinWidth="620" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F4F0E6">
  <Window.Styles>
    <Style Selector="TextBlock.section"><Setter Property="FontFamily" Value="Bahnschrift"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#1D2824"/><Setter Property="LetterSpacing" Value="1.5"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#FFFCF5"/><Setter Property="BorderBrush" Value="#D4CFC1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="18"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#416E35"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#66706B"/><Setter Property="FontSize" Value="11"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="76,*,66">
    <Border Background="#FBF9F2" BorderBrush="#C8C3B6" BorderThickness="0,0,0,1" Padding="24,14">
      <StackPanel Spacing="2"><TextBlock Text="CUSTOM SIMULATION COSTS" FontFamily="Bahnschrift" FontSize="24" FontWeight="Bold" LetterSpacing="1.6"/><TextBlock Text="Edit the cost contract used by the next offline world" Classes="muted" FontSize="12"/></StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" Margin="16">
      <StackPanel Spacing="14">
        <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="BASE COSTS"/><TextBlock Classes="muted" Text="These values are translated to the Rust engine when the next world starts. Zero disables a cost." TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Global cost multiplier"/><NumericUpDown Grid.Column="1" x:Name="GlobalCostMultiplier" Minimum="0" Maximum="100000" Increment="0.01"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="DNA number"/><NumericUpDown Grid.Column="1" x:Name="DnaNumber" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA dereference"/><NumericUpDown Grid.Column="1" x:Name="DnaDereference" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA basic"/><NumericUpDown Grid.Column="1" x:Name="DnaBasic" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA advanced"/><NumericUpDown Grid.Column="1" x:Name="DnaAdvanced" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA bitwise"/><NumericUpDown Grid.Column="1" x:Name="DnaBitwise" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA condition"/><NumericUpDown Grid.Column="1" x:Name="DnaCondition" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA logic"/><NumericUpDown Grid.Column="1" x:Name="DnaLogic" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA store"/><NumericUpDown Grid.Column="1" x:Name="DnaStore" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA flow"/><NumericUpDown Grid.Column="1" x:Name="DnaFlow" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="DNA upkeep"/><NumericUpDown Grid.Column="1" x:Name="DnaUpkeep" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="DNA copy"/><NumericUpDown Grid.Column="1" x:Name="DnaCopy" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Movement"/><NumericUpDown Grid.Column="1" x:Name="MovementCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Rotation"/><NumericUpDown Grid.Column="1" x:Name="RotationCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Tie formation"/><NumericUpDown Grid.Column="1" x:Name="TieFormationCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Shot formation"/><NumericUpDown Grid.Column="1" x:Name="ShotFormationCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Venom"/><NumericUpDown Grid.Column="1" x:Name="VenomCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Poison"/><NumericUpDown Grid.Column="1" x:Name="PoisonCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Slime"/><NumericUpDown Grid.Column="1" x:Name="SlimeCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Shell"/><NumericUpDown Grid.Column="1" x:Name="ShellCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Body upkeep"/><NumericUpDown Grid.Column="1" x:Name="BodyUpkeep" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Chloroplast construction"/><NumericUpDown Grid.Column="1" x:Name="ChloroplastConstructionCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Virus"/><NumericUpDown Grid.Column="1" x:Name="VirusCost" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Age base"/><NumericUpDown Grid.Column="1" x:Name="AgeBase" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Age start"/><NumericUpDown Grid.Column="1" x:Name="AgeStart" Minimum="0" Maximum="100000000" Increment="1"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Age linear"/><NumericUpDown Grid.Column="1" x:Name="AgeLinear" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Age logarithmic"/><NumericUpDown Grid.Column="1" x:Name="AgeLogarithmic" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid>
        </StackPanel></Border>
        <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="DYNAMIC COSTS"/><Grid ColumnDefinitions="*,150"><TextBlock Text="Dynamic multiplier"/><NumericUpDown Grid.Column="1" x:Name="DynamicMultiplier" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><CheckBox x:Name="DynamicAllRobots" Content="Apply dynamic cost to all robots"/><Grid ColumnDefinitions="*,150"><TextBlock Text="Target population"/><NumericUpDown Grid.Column="1" x:Name="DynamicTargetPopulation" Minimum="0" Maximum="100000000"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Population range"/><NumericUpDown Grid.Column="1" x:Name="DynamicPopulationRange" Minimum="0" Maximum="100000000"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Sensitivity"/><NumericUpDown Grid.Column="1" x:Name="DynamicSensitivity" Minimum="-100000" Maximum="100000" Increment="0.01"/></Grid><CheckBox x:Name="DynamicAllowNegative" Content="Allow negative dynamic costs"/><Grid ColumnDefinitions="*,150"><TextBlock Text="Lower zero threshold"/><NumericUpDown Grid.Column="1" x:Name="DynamicLowerZeroThreshold" Minimum="0" Maximum="100000000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Upper zero threshold"/><NumericUpDown Grid.Column="1" x:Name="DynamicUpperZeroThreshold" Minimum="0" Maximum="100000000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Lower reinstate threshold"/><NumericUpDown Grid.Column="1" x:Name="DynamicLowerReinstateThreshold" Minimum="0" Maximum="100000000" Increment="0.01"/></Grid><Grid ColumnDefinitions="*,150"><TextBlock Text="Upper reinstate threshold"/><NumericUpDown Grid.Column="1" x:Name="DynamicUpperReinstateThreshold" Minimum="0" Maximum="100000000" Increment="0.01"/></Grid></StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#E5E0D4" BorderBrush="#C8C3B6" BorderThickness="0,1,0,0" Padding="18,10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Changes apply to the next world setup." Classes="muted" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="CancelButton" Content="CANCEL" Click="Cancel_Click"/><Button x:Name="ApplyButton" Classes="primary" Content="SAVE COSTS" Click="Apply_Click"/></StackPanel></Grid></Border>
  </Grid>
</Window>
