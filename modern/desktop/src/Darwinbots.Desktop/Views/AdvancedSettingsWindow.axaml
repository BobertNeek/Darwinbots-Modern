<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Darwinbots.Desktop.Views.AdvancedSettingsWindow"
        Title="Darwinbots Live Settings" Width="900" Height="760" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F4F0E6">
  <Window.Styles>
    <Style Selector="TextBlock.section"><Setter Property="FontFamily" Value="Bahnschrift"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#1D2824"/><Setter Property="LetterSpacing" Value="1.5"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#FFFCF5"/><Setter Property="BorderBrush" Value="#D4CFC1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="18"/></Style>
    <Style Selector="TabItem"><Setter Property="FontFamily" Value="Bahnschrift"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="18,14"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#416E35"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="68,*,62">
    <Border Background="#FBF9F2" BorderBrush="#C8C3B6" BorderThickness="0,0,0,1" Padding="22,13">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2"><TextBlock Text="LIVE SETTINGS" FontFamily="Bahnschrift" FontSize="23" FontWeight="Bold" LetterSpacing="1.5"/><TextBlock Text="Tune the running ecosystem without interrupting evolution" Foreground="#66706B" FontSize="12"/></StackPanel>
        <Border x:Name="DirtyBadge" Grid.Column="1" Background="#E7EEDC" BorderBrush="#AEBE9D" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" IsVisible="False"><TextBlock x:Name="DirtyIndicator" Text="●  STAGED CHANGES" Foreground="#416E35" FontFamily="Bahnschrift" FontSize="11" FontWeight="Bold"/></Border>
      </Grid>
    </Border>

    <TabControl x:Name="SettingsTabs" Grid.Row="1" TabStripPlacement="Left" Margin="16" Background="Transparent">
      <TabItem Header="MUTATION"><ScrollViewer><StackPanel Margin="18,0,4,20" Spacing="14">
        <Border Classes="card"><StackPanel Spacing="12">
          <TextBlock Classes="section" Text="GLOBAL MUTATION PRESSURE"/>
          <CheckBox x:Name="MutationsEnabled" Content="Enable configured random mutations"/>
          <Grid ColumnDefinitions="180,*,118" ColumnSpacing="12"><StackPanel><TextBlock Text="Global multiplier"/><TextBlock Text="Scales every species rate" Foreground="#758078" FontSize="11"/></StackPanel><Slider Grid.Column="1" x:Name="GlobalMutationSlider" Minimum="0" Maximum="5" TickFrequency="0.05"/><NumericUpDown Grid.Column="2" x:Name="GlobalMutationRate" Minimum="0" Maximum="5" Increment="0.05" FormatString="0.00x"/></Grid>
        </StackPanel></Border>
        <Border Classes="card"><StackPanel Spacing="12">
          <TextBlock Classes="section" Text="SPECIES MUTATION RATES"/>
          <TextBlock Text="Each percentage is tested when that species reproduces. DNA-requested mutation remains under the bot's own control." TextWrapping="Wrap" Foreground="#66706B"/>
          <StackPanel x:Name="SpeciesMutationRows" Spacing="10"/>
        </StackPanel></Border>
        <Border Classes="card"><StackPanel Spacing="8">
          <TextBlock Classes="section" Text="DETAILED MUTATION CLASSES"/>
          <TextBlock Text="One-in rates feed the native Gaussian mutation profile. Point, delta, copy error, indel, reversal, amplification, and translocation remain distinct." TextWrapping="Wrap" Foreground="#66706B"/>
          <Grid ColumnDefinitions="*,105,*,105" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Text="Point" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="PointOneIn" Minimum="1" Maximum="100000000" Value="5000"/>
            <TextBlock Grid.Column="2" Text="Point2" VerticalAlignment="Center"/><NumericUpDown Grid.Column="3" x:Name="Point2OneIn" Minimum="1" Maximum="100000000" Value="5000"/>
            <TextBlock Grid.Row="1" Text="Delta" VerticalAlignment="Center"/><NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="DeltaOneIn" Minimum="1" Maximum="100000000" Value="5000"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Copy error" VerticalAlignment="Center"/><NumericUpDown Grid.Row="1" Grid.Column="3" x:Name="CopyErrorOneIn" Minimum="1" Maximum="100000000" Value="5000"/>
            <TextBlock Grid.Row="2" Text="Copy error2" VerticalAlignment="Center"/><NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="CopyError2OneIn" Minimum="1" Maximum="100000000" Value="5000"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Insertion" VerticalAlignment="Center"/><NumericUpDown Grid.Row="2" Grid.Column="3" x:Name="InsertionOneIn" Minimum="1" Maximum="100000000" Value="5000"/>
            <TextBlock Grid.Row="3" Text="Reversal" VerticalAlignment="Center"/><NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="ReversalOneIn" Minimum="1" Maximum="100000000" Value="5000"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="Minor deletion" VerticalAlignment="Center"/><NumericUpDown Grid.Row="3" Grid.Column="3" x:Name="MinorDeletionOneIn" Minimum="1" Maximum="100000000" Value="5000"/>
            <TextBlock Grid.Row="4" Text="Major deletion" VerticalAlignment="Center"/><NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="MajorDeletionOneIn" Minimum="1" Maximum="100000000" Value="5000"/>
            <TextBlock Grid.Row="4" Grid.Column="2" Text="Amplification" VerticalAlignment="Center"/><NumericUpDown Grid.Row="4" Grid.Column="3" x:Name="AmplificationOneIn" Minimum="1" Maximum="100000000" Value="5000"/>
            <TextBlock Grid.Row="5" Text="Translocation" VerticalAlignment="Center"/><NumericUpDown Grid.Row="5" Grid.Column="1" x:Name="TranslocationOneIn" Minimum="1" Maximum="100000000" Value="5000"/>
          </Grid>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>

      <TabItem Header="ENERGY"><ScrollViewer><StackPanel Margin="18,0,4,20" Spacing="14">
        <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="ENERGY ECONOMY"/>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Metabolism per tick"/><NumericUpDown Grid.Column="1" x:Name="Metabolism" Minimum="0" Maximum="100"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Vegetable compatibility bonus"/><NumericUpDown Grid.Column="1" x:Name="VegetableEnergy" Minimum="0" Maximum="1000"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Sunlight intensity"/><NumericUpDown Grid.Column="1" x:Name="Sunlight" Minimum="0" Maximum="10000"/></Grid>
        </StackPanel></Border>
        <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="VEGETATION"/>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Starting chloroplasts"/><NumericUpDown Grid.Column="1" x:Name="StartChloroplasts" Minimum="0" Maximum="32000" Increment="100"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Max energy per tick"/><NumericUpDown Grid.Column="1" x:Name="MaxPlantEnergy" Minimum="0" Maximum="32000" Increment="10"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Minimum chloroplast equivalents"/><NumericUpDown Grid.Column="1" x:Name="MinimumChloroplastEquivalents" Minimum="0" Maximum="1000000" Increment="10"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Repopulation amount"/><NumericUpDown Grid.Column="1" x:Name="RepopulationAmount" Minimum="0" Maximum="100000"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Repopulation cooldown"/><NumericUpDown Grid.Column="1" x:Name="RepopulationCooldown" Minimum="0" Maximum="100000000" Increment="100"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Feeding to body"/><NumericUpDown Grid.Column="1" x:Name="FeedingToBody" Minimum="0" Maximum="1" Increment="0.01"/></Grid>
          <CheckBox x:Name="Daytime" Content="Daytime"/><CheckBox x:Name="DayNightEnabled" Content="Day/night cycle"/>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Cycle length"/><NumericUpDown Grid.Column="1" x:Name="CycleLength" Minimum="1" Maximum="100000000" Increment="100"/></Grid>
          <CheckBox x:Name="PondMode" Content="Pond mode (buoyancy and depth light)"/>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Pond light intensity"/><NumericUpDown Grid.Column="1" x:Name="PondLightIntensity" Minimum="0" Maximum="100000" Increment="1"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Pond depth gradient"/><NumericUpDown Grid.Column="1" x:Name="PondGradient" Minimum="0" Maximum="10" Increment="0.01" FormatString="0.00"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Tide period (cycles, 0 off)"/><NumericUpDown Grid.Column="1" x:Name="TidePeriod" Minimum="0" Maximum="100000000" Increment="1"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Tide phase offset"/><NumericUpDown Grid.Column="1" x:Name="TideOffset" Minimum="-100000000" Maximum="100000000" Increment="1"/></Grid>
          <CheckBox x:Name="WeatherEnabled" Content="Enable weather and moving sun"/>
          <CheckBox x:Name="SunUpEnabled" Content="Force sun up below total-energy threshold"/>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Sun-up threshold"/><NumericUpDown Grid.Column="1" x:Name="SunUpThreshold" Minimum="0" Maximum="2147483647" Increment="1000"/></Grid>
          <CheckBox x:Name="SunDownEnabled" Content="Force sun down above total-energy threshold"/>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Sun-down threshold"/><NumericUpDown Grid.Column="1" x:Name="SunDownThreshold" Minimum="0" Maximum="2147483647" Increment="1000"/></Grid>
          <Grid ColumnDefinitions="*,220"><TextBlock Text="Threshold mode"/><ComboBox Grid.Column="1" x:Name="SunThresholdMode" SelectedIndex="0">
            <ComboBoxItem Content="Temporary suspend"/>
            <ComboBoxItem Content="Permanent toggle"/>
            <ComboBoxItem Content="Advance to dawn/dusk"/>
          </ComboBox></Grid>
        </StackPanel></Border>
        <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="WASTE + CORPSE + SAMPLING"/>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Alzheimer waste threshold"/><NumericUpDown Grid.Column="1" x:Name="WasteThreshold" Minimum="0" Maximum="2147483647"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Defecation threshold"/><NumericUpDown Grid.Column="1" x:Name="DefecationThreshold" Minimum="0" Maximum="2147483647"/></Grid>
          <CheckBox x:Name="CorpseEnabled" Content="Enable corpse decay"/>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Death energy threshold"/><NumericUpDown Grid.Column="1" x:Name="CorpseDeathEnergyThreshold" Minimum="0" Maximum="2147483647"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Corpse mode"/><ComboBox Grid.Column="1" x:Name="CorpseMode"><ComboBoxItem Content="None"/><ComboBoxItem Content="Waste shot"/><ComboBoxItem Content="Energy shot"/></ComboBox></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Corpse packet size"/><NumericUpDown Grid.Column="1" x:Name="CorpsePacketSize" Minimum="1" Maximum="2147483647"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Corpse period"/><NumericUpDown Grid.Column="1" x:Name="CorpsePeriod" Minimum="1" Maximum="1000000000"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Graph sampling interval"/><NumericUpDown Grid.Column="1" x:Name="SamplingInterval" Minimum="1" Maximum="1000000"/></Grid>
          <CheckBox x:Name="SafeModeBackup" Content="Keep safe-mode backup"/>
          <CheckBox x:Name="DeadSnapshotEnabled" Content="Capture dead snapshots"/>
          <CheckBox x:Name="ExcludeRepopulatingRobots" Content="Exclude repopulating robots from samples"/>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Autosave interval"/><NumericUpDown Grid.Column="1" x:Name="AutosaveInterval" Minimum="0" Maximum="1000000000"/></Grid>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>

      <TabItem Header="PHYSICS"><ScrollViewer><StackPanel Margin="18,0,4,20" Spacing="14">
        <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="MOTION + MEDIUM"/>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Physics preset" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="PhysicsPreset" SelectedIndex="0"><ComboBoxItem Content="Fluid"/><ComboBoxItem Content="Solid"/><ComboBoxItem Content="Custom"/></ComboBox></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Maximum velocity"/><NumericUpDown Grid.Column="1" x:Name="MaxVelocity" Minimum="1" Maximum="10000"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Movement efficiency"/><NumericUpDown Grid.Column="1" x:Name="MovementEfficiency" Minimum="0.01" Maximum="10" Increment="0.01"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Gravity X"/><NumericUpDown Grid.Column="1" x:Name="GravityX" Minimum="-100" Maximum="100" Increment="0.1"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Gravity Y"/><NumericUpDown Grid.Column="1" x:Name="GravityY" Minimum="-100" Maximum="100" Increment="0.1"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Surface gravity"/><NumericUpDown Grid.Column="1" x:Name="SurfaceGravity" Minimum="0" Maximum="100" Increment="0.01"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Static friction"/><NumericUpDown Grid.Column="1" x:Name="StaticFriction" Minimum="0" Maximum="100" Increment="0.01"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Kinetic friction"/><NumericUpDown Grid.Column="1" x:Name="KineticFriction" Minimum="0" Maximum="100" Increment="0.01"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Fluid density"/><NumericUpDown Grid.Column="1" x:Name="Density" Minimum="0" Maximum="100" Increment="0.000001" FormatString="0.######"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Viscosity"/><NumericUpDown Grid.Column="1" x:Name="Viscosity" Minimum="0" Maximum="100" Increment="0.000001" FormatString="0.######"/></Grid>
          <Border Background="#E7EEDC" Padding="8"><StackPanel Spacing="3"><TextBlock Text="REYNOLDS DISPLAY" Classes="section"/><TextBlock x:Name="ReynoldsDisplay" Text="0 · LAMINAR" FontWeight="Bold"/><TextBlock x:Name="PhysicsHelpText" Text="Reynolds number is unitless. Values below 3E+5 are characteristic of laminar flow." TextWrapping="Wrap" Foreground="#66706B"/></StackPanel></Border>
          <Button x:Name="PhysicsHelpButton" Content="HELP ON UNITS + GENERAL PHYSICS" HorizontalAlignment="Left" Click="PhysicsHelp_Click"/>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Collision elasticity"/><NumericUpDown Grid.Column="1" x:Name="Elasticity" Minimum="0" Maximum="2" Increment="0.01"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Drag"/><NumericUpDown Grid.Column="1" x:Name="Drag" Minimum="0" Maximum="1" Increment="0.01"/></Grid>
          <Grid ColumnDefinitions="*,150"><StackPanel><TextBlock Text="Brownian motion"/><TextBlock Text="0% off · 75% DB2 medium · 100% high" Foreground="#758078" FontSize="11"/></StackPanel><NumericUpDown Grid.Column="1" x:Name="Brownian" Minimum="0" Maximum="100"/></Grid>
          <CheckBox x:Name="PlanetEaters" Content="Enable Planet Eaters mutual gravity"/>
           <Grid ColumnDefinitions="*,150"><TextBlock Text="Planet Eaters G"/><NumericUpDown Grid.Column="1" x:Name="PlanetEatersG" Minimum="0" Maximum="1000000" Increment="0.01"/></Grid>
           <CheckBox x:Name="ZeroMomentum" Content="Zero momentum (no carried motion)"/>
        </StackPanel></Border>
        <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="SHOTS"/>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Speed"/><NumericUpDown Grid.Column="1" x:Name="ShotSpeed" Minimum="1" Maximum="1000"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Range multiplier"/><NumericUpDown Grid.Column="1" x:Name="ShotRangeMultiplier" Minimum="0.01" Maximum="100" Increment="0.1"/></Grid>
          <Grid ColumnDefinitions="*,150"><TextBlock Text="Decay"/><NumericUpDown Grid.Column="1" x:Name="ShotDecay" Minimum="0" Maximum="10000"/></Grid>
          <CheckBox x:Name="EnergyShotsNoDecay" Content="Energy shots do not decay"/><CheckBox x:Name="WasteShotsNoDecay" Content="Waste shots do not decay"/>
        </StackPanel></Border>
       </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="WORLD"><ScrollViewer><StackPanel Margin="18,0,4,20" Spacing="14">
        <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="WORLD TOPOLOGY"/><CheckBox x:Name="ToroidalWorld" Content="Wrap both axes (toroidal world)"/><CheckBox x:Name="WrapX" Content="Wrap left and right edges"/><CheckBox x:Name="WrapY" Content="Wrap top and bottom edges"/><TextBlock Text="Each axis is independent. Bounded edges keep the robot radius inside the world and report edge contact." TextWrapping="Wrap" Foreground="#66706B"/></StackPanel></Border>
        <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="LINEAGES"/><CheckBox x:Name="AutoSpeciation" Content="Automatic speciation after accumulated DNA mutations"/><Grid ColumnDefinitions="*,150"><TextBlock Text="Genetic distance threshold (%)"/><NumericUpDown Grid.Column="1" x:Name="SpeciationDistance" Minimum="0.1" Maximum="10000" Increment="0.5" FormatString="0.0"/></Grid><TextBlock Text="A lineage receives a modest inherited skin-color change after this percentage of its DNA has mutated." TextWrapping="Wrap" Foreground="#66706B"/></StackPanel></Border>
       </StackPanel></ScrollViewer></TabItem>
       <TabItem Header="INTERNET" IsEnabled="False"><Border Classes="card" Margin="18,0,4,20"><StackPanel Spacing="8"><TextBlock Classes="section" Text="INTERNET DISABLED"/><TextBlock Text="Historical internet settings remain visible for compatibility. This local-only runtime does not connect, transfer, or start online services." TextWrapping="Wrap"/><TextBlock Text="No online backend is configured." Foreground="#794A1D"/></StackPanel></Border></TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#E5E0D4" BorderBrush="#C8C3B6" BorderThickness="0,1,0,0" Padding="16,10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Changes apply to the running simulation on the engine thread." VerticalAlignment="Center" Foreground="#66706B"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="CancelButton" Content="CANCEL" Click="Cancel_Click"/><Button x:Name="ApplyButton" Classes="primary" Content="APPLY CHANGES" Click="Apply_Click"/></StackPanel></Grid></Border>
  </Grid>
</Window>
