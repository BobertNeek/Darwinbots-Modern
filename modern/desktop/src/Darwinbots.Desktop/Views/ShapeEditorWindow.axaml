<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Darwinbots.Desktop.Views.ShapeEditorWindow"
        Title="Shape properties" Width="430" Height="650" MinWidth="390" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F4F0E6">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18" RowSpacing="14">
    <StackPanel Spacing="3">
      <TextBlock Text="SHAPE PROPERTIES" FontSize="20" FontWeight="Bold" />
      <TextBlock Text="Edit shape movement, appearance and how bots see it." Foreground="#66706B" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="9">
        <CheckBox x:Name="ShapesVisibleToggle" Content="Bots can see shape surfaces (all shapes)"/>
        <Grid ColumnDefinitions="*,150"><TextBlock Text="Minimum X" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="MinimumX" Minimum="-1000000" Maximum="1000000" Increment="1" FormatString="0.0" /></Grid>
        <Grid ColumnDefinitions="*,150"><TextBlock Text="Minimum Y" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="MinimumY" Minimum="-1000000" Maximum="1000000" Increment="1" FormatString="0.0" /></Grid>
        <Grid ColumnDefinitions="*,150"><TextBlock Text="Maximum X" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="MaximumX" Minimum="-1000000" Maximum="1000000" Increment="1" FormatString="0.0" /></Grid>
        <Grid ColumnDefinitions="*,150"><TextBlock Text="Maximum Y" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="MaximumY" Minimum="-1000000" Maximum="1000000" Increment="1" FormatString="0.0" /></Grid>
        <Grid ColumnDefinitions="*,150"><TextBlock Text="Color (ARGB hex)" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="ColorText" /></Grid>
        <Grid ColumnDefinitions="*,150"><TextBlock Text="Opacity" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="OpacityValue" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" /></Grid>
        <Grid ColumnDefinitions="*,150"><TextBlock Text="Horizontal drift" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="DriftX" Minimum="-100000" Maximum="100000" Increment="0.1" FormatString="0.0" /></Grid>
        <Grid ColumnDefinitions="*,150"><TextBlock Text="Vertical drift" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="DriftY" Minimum="-100000" Maximum="100000" Increment="0.1" FormatString="0.0" /></Grid>
        <Grid ColumnDefinitions="*,150"><TextBlock Text="Vision policy" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="VisionPolicy"><ComboBoxItem Content="Opaque"/><ComboBoxItem Content="See through"/></ComboBox></Grid>
        <Grid ColumnDefinitions="*,150"><TextBlock Text="Shot policy" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="ShotPolicy"><ComboBoxItem Content="Absorb"/><ComboBoxItem Content="Pass through"/></ComboBox></Grid>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="CANCEL" Click="Cancel_Click" />
      <Button Content="APPLY" Background="#416E35" Foreground="White" Click="Apply_Click" />
    </StackPanel>
  </Grid>
</Window>
