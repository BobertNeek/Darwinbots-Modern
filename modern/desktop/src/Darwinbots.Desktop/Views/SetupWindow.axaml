<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Darwinbots.Desktop.Views.SetupWindow"
        x:CompileBindings="False"
        Title="Darwinbots Modern — New World"
        Width="1280" Height="820" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        KeyDown="SetupWindow_KeyDown">
  <Grid RowDefinitions="64,*,34" ColumnDefinitions="210,*,290">
    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#FBF9F2" BorderBrush="#BEBBB2" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="210,*" Margin="18,0">
        <TextBlock Text="DARWINBOTS" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="27" VerticalAlignment="Center" />
        <Menu Grid.Column="1" Background="Transparent" VerticalAlignment="Center">
          <MenuItem x:Name="FileMenu" Header="_FILE">
            <MenuItem x:Name="NewWorldMenuItem" Header="NEW WORLD" HotKey="Ctrl+N" Click="NewWorld_Click"/>
            <MenuItem x:Name="OpenSaveMenuItem" Header="OPEN SAVE..." HotKey="Ctrl+O" Click="OpenSave_Click"/>
            <MenuItem x:Name="RecoverMenuItem" Header="RECOVER LATEST AUTOSAVE" Click="Recover_Click"/>
            <Separator/>
            <MenuItem x:Name="ExitMenuItem" Header="EXIT" HotKey="Alt+F4" Click="Exit_Click"/>
          </MenuItem>
          <MenuItem x:Name="ViewMenu" Header="_VIEW">
            <MenuItem x:Name="AdvancedMenuItem" Header="ADVANCED SETTINGS" HotKey="Ctrl+," Click="Advanced_Click"/>
            <MenuItem x:Name="GlobalSettingsMenuItem" Header="GLOBAL SETTINGS" HotKey="Ctrl+G" Click="GlobalSettings_Click"/>
          </MenuItem>
          <MenuItem x:Name="HelpMenu" Header="_HELP">
            <MenuItem x:Name="AboutMenuItem" Header="ABOUT DARWINBOTS MODERN" HotKey="F1" Click="About_Click"/>
          </MenuItem>
        </Menu>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="#F7F4EC" BorderBrush="#C8C5BB" BorderThickness="0,0,1,0">
      <TabControl x:Name="SimulationSettingsTabs" TabStripPlacement="Left" Margin="8,20">
        <TabItem Header="SPECIES"><TextBlock Text="Species and DNA" TextWrapping="Wrap" Margin="8"/></TabItem>
        <TabItem Header="GENERAL"><TextBlock Text="World size, backend, and runtime defaults" TextWrapping="Wrap" Margin="8"/></TabItem>
        <TabItem Header="PHYSICS AND COSTS"><TextBlock Text="Physics, energy, and shot costs" TextWrapping="Wrap" Margin="8"/></TabItem>
        <TabItem Header="MUTATIONS"><TextBlock Text="Mutation and speciation controls" TextWrapping="Wrap" Margin="8"/></TabItem>
        <TabItem Header="RESTART AND LEAGUE"><TextBlock Text="Restart, Zerobot, and local league controls" TextWrapping="Wrap" Margin="8"/></TabItem>
        <TabItem Header="INTERNET"><TextBlock Text="Internet play is disabled in this offline build" TextWrapping="Wrap" Margin="8"/></TabItem>
      </TabControl>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="36,28" Spacing="18">
        <TextBlock Classes="section" Text="STARTING MODE" FontSize="15"/>
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
          <RadioButton x:Name="StarterMode" GroupName="Mode" IsChecked="True" Click="Mode_Checked" HorizontalContentAlignment="Center" Padding="18" MinHeight="112">
            <StackPanel HorizontalAlignment="Center" Spacing="12"><TextBlock Text="◉ + ♧" FontSize="30" HorizontalAlignment="Center" Foreground="#3E7336"/><TextBlock Text="STARTER BOTS + VEGETABLES" FontWeight="Bold"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="ZerobotMode" Grid.Column="1" GroupName="Mode" Click="Mode_Checked" HorizontalContentAlignment="Center" Padding="18" MinHeight="112">
            <StackPanel HorizontalAlignment="Center" Spacing="12"><TextBlock Text="◉" FontSize="30" HorizontalAlignment="Center"/><TextBlock Text="ZEROBOTS" FontWeight="Bold"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="ZerobotVegetableMode" Grid.Column="2" GroupName="Mode" Click="Mode_Checked" HorizontalContentAlignment="Center" Padding="18" MinHeight="112">
            <StackPanel HorizontalAlignment="Center" Spacing="12"><TextBlock Text="◉ + ♧" FontSize="30" HorizontalAlignment="Center" Foreground="#126173"/><TextBlock Text="ZEROBOTS + VEGETABLES" FontWeight="Bold"/></StackPanel>
          </RadioButton>
        </Grid>

        <TextBlock Classes="section" Text="SPECIES" FontSize="15" Margin="0,8,0,0"/>
        <Border Classes="panel">
          <Grid RowDefinitions="38,*">
            <Grid ColumnDefinitions="2*,90,100,95,135,80,105,44" Background="#EEEAE0" Margin="1">
              <TextBlock Text="SPECIES" Margin="10"/><TextBlock Grid.Column="1" Text="TYPE" Margin="8"/><TextBlock Grid.Column="2" Text="INITIAL COUNT" Margin="8"/><TextBlock Grid.Column="3" Text="ENERGY" Margin="8"/><TextBlock Grid.Column="4" Text="MUTATION %" Margin="8"/><TextBlock Grid.Column="5" Text="RESEED" Margin="8"/><TextBlock Grid.Column="6" Text="EDITOR" Margin="8"/>
            </Grid>
            <ItemsControl x:Name="SpeciesList" Grid.Row="1" ItemsSource="{Binding Species}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="2*,90,100,95,135,80,105,44" Margin="6,5">
                    <TextBox Text="{Binding Name}"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Vegetable}" Content="VEG" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="2" Value="{Binding InitialCount}" Minimum="1" Maximum="100000"/>
                    <NumericUpDown Grid.Column="3" Value="{Binding InitialEnergy}" Minimum="1" Maximum="32000"/>
                    <Grid Grid.Column="4" ColumnDefinitions="*,48" Margin="4,0">
                      <Slider Minimum="0" Maximum="100" Value="{Binding MutationRate, Mode=TwoWay}" TickFrequency="0.1"/>
                      <TextBlock Grid.Column="1" Text="{Binding MutationRate, StringFormat='{}{0:0.0}%'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox Grid.Column="5" IsChecked="{Binding Reseed}" HorizontalAlignment="Center"/>
                    <Expander Grid.Column="6" Header="EDIT" IsExpanded="False" HorizontalAlignment="Stretch">
                      <StackPanel Spacing="5" MinWidth="290">
                        <TextBlock Text="STARTUP POLICY" Classes="section"/>
                        <Grid ColumnDefinitions="*,100"><TextBlock Text="Minimum population" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Value="{Binding MinimumPopulation}" Minimum="0" Maximum="100000"/></Grid>
                        <Grid ColumnDefinitions="*,100"><TextBlock Text="Placement" VerticalAlignment="Center"/><ComboBox Grid.Column="1" SelectedIndex="{Binding PlacementIndex, Mode=TwoWay}"><ComboBoxItem Content="Random"/><ComboBoxItem Content="Center"/><ComboBoxItem Content="Fixed"/></ComboBox></Grid>
                        <Grid ColumnDefinitions="*,100"><TextBlock Text="Fixed X" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Value="{Binding PlacementX}" Minimum="-1000000" Maximum="1000000"/></Grid>
                        <Grid ColumnDefinitions="*,100"><TextBlock Text="Fixed Y" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Value="{Binding PlacementY}" Minimum="-1000000" Maximum="1000000"/></Grid>
                        <TextBlock Text="SKIN POINTS" Classes="section" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding SkinPreview}" Foreground="#66706B" FontSize="11"/>
                        <Grid ColumnDefinitions="*,58,58"><TextBlock Text="Point 0" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Value="{Binding SkinRadius0}" Minimum="0.15" Maximum="0.82" Increment="0.01"/><NumericUpDown Grid.Column="2" Value="{Binding SkinAngle0}" Minimum="0" Maximum="1256"/></Grid>
                        <Grid ColumnDefinitions="*,58,58"><TextBlock Text="Point 1" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Value="{Binding SkinRadius1}" Minimum="0.15" Maximum="0.82" Increment="0.01"/><NumericUpDown Grid.Column="2" Value="{Binding SkinAngle1}" Minimum="0" Maximum="1256"/></Grid>
                        <Grid ColumnDefinitions="*,58,58"><TextBlock Text="Point 2" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Value="{Binding SkinRadius2}" Minimum="0.15" Maximum="0.82" Increment="0.01"/><NumericUpDown Grid.Column="2" Value="{Binding SkinAngle2}" Minimum="0" Maximum="1256"/></Grid>
                        <Grid ColumnDefinitions="*,58,58"><TextBlock Text="Point 3" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Value="{Binding SkinRadius3}" Minimum="0.15" Maximum="0.82" Increment="0.01"/><NumericUpDown Grid.Column="2" Value="{Binding SkinAngle3}" Minimum="0" Maximum="1256"/></Grid>
                        <TextBlock Text="RESTRICTIONS" Classes="section" Margin="0,4,0,0"/>
                        <WrapPanel Orientation="Horizontal" ItemHeight="25">
                          <CheckBox Content="NO VISION" IsChecked="{Binding DisableVision}"/>
                          <CheckBox Content="NO DNA" IsChecked="{Binding DisableDna}"/>
                          <CheckBox Content="NO MOVE" IsChecked="{Binding DisableMovement}"/>
                          <CheckBox Content="NO REPRO" IsChecked="{Binding DisableReproduction}"/>
                          <CheckBox Content="VIRUS IMMUNE" IsChecked="{Binding VirusImmune}"/>
                          <CheckBox Content="NO MUTATIONS" IsChecked="{Binding DisableMutations}"/>
                          <CheckBox Content="NO CHLOROPLASTS" IsChecked="{Binding DisableChloroplasts}"/>
                          <CheckBox Content="FIXED" IsChecked="{Binding FixedInPlace}"/>
                          <CheckBox Content="KILL MULTIBOT" IsChecked="{Binding KillMultibot}"/>
                          <CheckBox Content="KILL DISQUALIFIED" IsChecked="{Binding KillDisqualified}"/>
                        </WrapPanel>
                        <TextBox Text="{Binding Comment}" Watermark="Species comment"/>
                      </StackPanel>
                    </Expander>
                    <Button Grid.Column="7" Content="×" Tag="{Binding}" Click="RemoveSpecies_Click"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="AddDnaButton" Content="＋ ADD DNA FILE" Click="AddDna_Click"/><Button x:Name="DuplicateSpeciesButton" Content="DUPLICATE SPECIES" Click="DuplicateSpecies_Click"/><TextBlock x:Name="SetupStatus" VerticalAlignment="Center" Foreground="#A65A23"/></StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Grid.Column="2" Background="#F8F5ED" BorderBrush="#C8C5BB" BorderThickness="1,0,0,0">
      <ScrollViewer><StackPanel Margin="24,28" Spacing="10">
        <TextBlock Classes="section" Text="WORLD SETTINGS" FontSize="15" Margin="0,0,0,8"/>
        <TextBlock Text="BACKEND" FontWeight="Bold"/><ComboBox x:Name="Backend" SelectedIndex="0"><ComboBoxItem Content="Auto"/><ComboBoxItem Content="Cpu"/><ComboBoxItem Content="Gpu"/></ComboBox>
        <TextBlock Text="WORLD SIZE" FontWeight="Bold" Margin="0,10,0,0"/>
        <Grid ColumnDefinitions="*,12,*"><NumericUpDown x:Name="WorldWidth" Value="16000" Minimum="1000" Maximum="1000000"/><TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center"/><NumericUpDown Grid.Column="2" x:Name="WorldHeight" Value="12000" Minimum="1000" Maximum="1000000"/></Grid>
        <TextBlock Text="RANDOM SEED" FontWeight="Bold" Margin="0,10,0,0"/><Grid ColumnDefinitions="*,Auto"><NumericUpDown x:Name="Seed" Value="1" Minimum="1" Maximum="9223372036854775807"/><Button Grid.Column="1" x:Name="ChangeSeedButton" Content="CHANGE" Margin="8,0,0,0" Click="ChangeSeed_Click"/></Grid>
        <TextBlock Text="POPULATION CAP" FontWeight="Bold" Margin="0,10,0,0"/><NumericUpDown x:Name="PopulationCap" Value="25000" Minimum="100" Maximum="1000000" Increment="1000"/>
        <TextBlock Text="VEGETABLE CAP" FontWeight="Bold" Margin="0,10,0,0"/><NumericUpDown x:Name="VegetablePopulationCap" Value="500" Minimum="0" Maximum="1000000" Increment="50"/>
        <TextBlock Text="Maximum living vegetables" Foreground="#6F716D" FontSize="12"/>
        <TextBlock Text="SPEED" FontWeight="Bold" Margin="0,10,0,0"/><ComboBox x:Name="Speed" SelectedIndex="3"><ComboBoxItem Content="1×"/><ComboBoxItem Content="5×"/><ComboBoxItem Content="20×"/><ComboBoxItem Content="MAXIMUM"/></ComboBox>
        <TextBlock x:Name="SustenanceLabel" Text="ZEROBOT SUSTENANCE" FontWeight="Bold" Margin="0,10,0,0"/>
        <ComboBox x:Name="Sustenance" SelectedIndex="3"><ComboBoxItem Content="FEEDER + REPRODUCER"/><ComboBoxItem Content="ENERGY-ONLY FEEDER"/><ComboBoxItem Content="PHOTOSYNTHETIC ZEROBOTS"/><ComboBoxItem Content="DISABLED METABOLISM"/><ComboBoxItem Content="NO ASSISTANCE"/></ComboBox>
        <TextBlock x:Name="SustenanceHint" TextWrapping="Wrap" Foreground="#6F716D" FontSize="12"/>
        <CheckBox x:Name="AutomaticProgression" IsChecked="True" Content="AUTOMATIC ZEROBOT PROGRESSION" Margin="0,8,0,0"/>
        <Button x:Name="AdvancedSettingsButton" Content="⚙  ADVANCED SETTINGS" Margin="0,18,0,0" Click="Advanced_Click"/>
        <Button x:Name="GlobalSettingsButton" Content="☷  GLOBAL SETTINGS" Click="GlobalSettings_Click"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="LoadSettingsButton" Content="LOAD SETTINGS" Click="LoadSettings_Click"/><Button x:Name="SaveSettingsButton" Content="SAVE SETTINGS" Click="SaveSettings_Click"/></StackPanel>
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6"><Button x:Name="StartNewButton" Content="START NEW" Click="StartNew_Click"/><Button x:Name="ChangeButton" Grid.Column="1" Content="CHANGE" Click="Change_Click"/><Button x:Name="CancelButton" Grid.Column="2" Content="CANCEL" Click="Cancel_Click"/></Grid>
        <Button x:Name="CreateWorldButton" Content="▶  CREATE WORLD" Background="#4C7D30" Foreground="White" FontWeight="Bold" FontSize="18" Height="58" Margin="0,12,0,0" Click="CreateWorld_Click"/>
        <Button x:Name="RecoverButton" Content="RECOVER LATEST AUTOSAVE" Click="Recover_Click"/>
      </StackPanel></ScrollViewer>
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#E6E2D8" BorderBrush="#BEBBB2" BorderThickness="0,1,0,0" Padding="12,7">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="READY — CONFIGURE A NEW EVOLUTION"/><TextBlock Grid.Column="1" Text="WINDOWS 10 ALPHA"/></Grid>
    </Border>

    <Border x:Name="OnboardingPanel" Grid.Row="1" Grid.ColumnSpan="3" IsVisible="False" Background="#F8F5ED" BorderBrush="#47763A" BorderThickness="2" Padding="44" HorizontalAlignment="Center" VerticalAlignment="Center" Width="620">
      <StackPanel Spacing="16">
        <TextBlock Text="GETTING STARTED" Classes="section" FontSize="22"/>
        <TextBlock Text="Please select your first simulation." FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="Choose starter bots or Zerobots, then use the six settings tabs to review the working copy before starting." TextWrapping="Wrap" Foreground="#59615D"/>
        <Button x:Name="OnboardingGotItButton" Content="GOT IT" HorizontalAlignment="Right" Click="OnboardingGotIt_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
