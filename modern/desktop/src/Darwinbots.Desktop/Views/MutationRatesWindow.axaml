<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Darwinbots.Desktop.Views.MutationRatesWindow"
        Title="Detailed Mutation Rates" Width="980" Height="720" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F4F0E6">
  <Window.Styles>
    <Style Selector="TextBlock.section"><Setter Property="FontFamily" Value="Bahnschrift"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#1D2824"/><Setter Property="LetterSpacing" Value="1.3"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#FFFCF5"/><Setter Property="BorderBrush" Value="#D4CFC1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="16"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#66706B"/><Setter Property="FontSize" Value="11"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#416E35"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="72,*,62">
    <Border Background="#FBF9F2" BorderBrush="#C8C3B6" BorderThickness="0,0,0,1" Padding="22,13">
      <StackPanel Spacing="2"><TextBlock Text="DETAILED MUTATION RATES" FontFamily="Bahnschrift" FontSize="22" FontWeight="Bold" LetterSpacing="1.4"/><TextBlock Text="Eleven DB2 mutation classes with Gaussian distributions and token-category outcomes" Classes="muted"/></StackPanel>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="235,*" Margin="16" ColumnSpacing="14">
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="MUTATION CLASS"/>
          <ComboBox x:Name="ClassSelector" SelectionChanged="ClassSelector_SelectionChanged"/>
          <TextBlock x:Name="ClassDescription" Classes="muted" TextWrapping="Wrap"/>
          <TextBlock Classes="muted" Text="Disabled classes retain their values and are excluded from runtime selection." TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="14" Margin="0,0,8,18">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="section" Text="CLASS PARAMETERS"/>
              <CheckBox x:Name="Enabled" Content="Class enabled"/>
              <Grid ColumnDefinitions="*,150" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Text="One in N" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Column="1" x:Name="OneIn" Minimum="1" Maximum="1000000000000000000" Increment="1" FormatString="0.###"/>
                <TextBlock Grid.Row="1" Text="Gaussian mean" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="Mean" Minimum="-1000000000" Maximum="1000000000" Increment="0.1" FormatString="0.###"/>
                <TextBlock Grid.Row="2" Text="Gaussian standard deviation" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="StdDev" Minimum="0" Maximum="1000000000" Increment="0.1" FormatString="0.###"/>
              </Grid>
              <Grid x:Name="PreferencePanel" ColumnDefinitions="*,150" Margin="0,4,0,0">
                <TextBlock Text="Change value vs token type" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="Preference" Minimum="0" Maximum="100" TickFrequency="10"/>
              </Grid>
              <TextBlock x:Name="PreferenceValue" Classes="muted" HorizontalAlignment="Right"/>
            </StackPanel>
          </Border>
          <Border x:Name="CategoryPanel" Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="section" Text="CATEGORY DISTRIBUTION"/>
              <TextBlock Classes="muted" Text="Percent of replacement outcomes. The six values must total 100%." TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,130" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="7">
                <TextBlock Text="Number" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="NumberCategory" Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##'%'"/>
                <TextBlock Grid.Row="1" Text="Dereference" VerticalAlignment="Center"/><NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="DereferenceCategory" Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##'%'"/>
                <TextBlock Grid.Row="2" Text="Operator" VerticalAlignment="Center"/><NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="OperatorCategory" Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##'%'"/>
                <TextBlock Grid.Row="3" Text="Logic" VerticalAlignment="Center"/><NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="LogicCategory" Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##'%'"/>
                <TextBlock Grid.Row="4" Text="Comparison" VerticalAlignment="Center"/><NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="ComparisonCategory" Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##'%'"/>
                <TextBlock Grid.Row="5" Text="Flow" VerticalAlignment="Center"/><NumericUpDown Grid.Row="5" Grid.Column="1" x:Name="FlowCategory" Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##'%'"/>
              </Grid>
              <TextBlock x:Name="CategoryTotal" Classes="muted" HorizontalAlignment="Right"/>
            </StackPanel>
          </Border>
          <Border Classes="card"><StackPanel Spacing="6"><TextBlock Classes="section" Text="SUMMARY"/><TextBlock x:Name="Summary" TextWrapping="Wrap"/></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Background="#E5E0D4" BorderBrush="#C8C3B6" BorderThickness="0,1,0,0" Padding="16,10">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Rust validates and owns the live mutation profile." Classes="muted" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="DEFAULT RATES" Click="Default_Click"/><Button Content="CANCEL" Click="Cancel_Click"/><Button Classes="primary" Content="APPLY" Click="Apply_Click"/></StackPanel></Grid>
    </Border>
  </Grid>
</Window>
